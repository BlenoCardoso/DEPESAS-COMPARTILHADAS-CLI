rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Função auxiliar para verificar se o usuário é o dono do documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Função auxiliar para verificar se o usuário é membro de um grupo
    function isMemberOfGroup(groupId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    
    // Regras para usuários
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // Regras para grupos
    match /groups/{groupId} {
      allow read: if isMemberOfGroup(groupId) || resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Deterministic membership documents groups/{groupId}/members/{userId}
      match /members/{userId} {
        allow read: if request.auth.uid == userId || resource.data.role in ['owner','admin'] && request.auth.uid == resource.id;
        allow write: if isAuthenticated() && (request.auth.uid == userId || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid);
      }
    }
    
    // Regras para membros de grupos
    // Legacy/flat membership collection kept for compatibility with server
    match /groupMembers/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId == request.auth.uid);
    }
    
    // Regras para despesas compartilhadas
    match /sharedExpenses/{expenseId} {
      allow read: if isMemberOfGroup(resource.data.groupId);
      allow create: if isAuthenticated() && isMemberOfGroup(request.resource.data.groupId);
      allow update: if isAuthenticated() && 
                     (resource.data.createdBy == request.auth.uid || 
                      isMemberOfGroup(resource.data.groupId));
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }
    
    // Regras para divisão de despesas
    match /expenseSplits/{splitId} {
      // Permit for the user whose split it is, or group members
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMemberOfGroup(resource.data.groupId));
      allow create, update, delete: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isMemberOfGroup(request.resource.data.groupId));
    }
    
    // Regras para despesas pessoais
    match /personalExpenses/{expenseId} {
      allow read, write: if isOwner(resource.data.userId);
    }
    
    // Regras para tarefas
    match /tasks/{taskId} {
      allow read, write: if isOwner(resource.data.userId);
    }
    
    // Regras para lembretes
    match /reminders/{reminderId} {
      allow read, write: if isOwner(resource.data.userId);
    }
    
    // Regras para eventos do calendário
    match /calendarEvents/{eventId} {
      allow read, write: if isOwner(resource.data.userId);
    }
    
    // Regras para convites
    match /invitations/{invitationId} {
      allow read: if isAuthenticated() && 
                   (resource.data.invitedEmail == request.auth.token.email || 
                    resource.data.invitedBy == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.invitedEmail == request.auth.token.email;
      allow delete: if isAuthenticated() && resource.data.invitedBy == request.auth.uid;
    }
    
    // Regras para notificações
    match /notifications/{notificationId} {
      allow read, write: if isOwner(resource.data.userId);
    }
  }
}
